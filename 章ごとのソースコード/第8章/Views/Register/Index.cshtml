@model RegisterUserInputModel
@{
    ViewData["Title"] = "ユーザー新規登録";
}
<h2>@ViewData["Title"]</h2>
<form asp-controller="Register" asp-action="Index" method="post">
    <!-- ユーザー名 -->
    <div>
        <label asp-for="UserName"></label>
        <input asp-for="UserName" />
    </div>
    <!-- 自己紹介 -->
    <div>
        <label asp-for="Bio"></label>
        <textarea asp-for="Bio"></textarea>
    </div>
    <!-- 性別（ラジオボタン） -->
    <div>
        <label asp-for="Gender"></label><br />
        <input type="radio" asp-for="Gender" value="男性" /> 男性
        <input type="radio" asp-for="Gender" value="女性" /> 女性
        <input type="radio" asp-for="Gender" value="その他" /> その他
    </div>
    <!-- いつも使う支払い方法（ドロップダウン） -->
    <div>
        <label asp-for="PaymentMethod"></label>
        @* オブジェクトを直接指定する場合 *@
        <select asp-for="PaymentMethod"
                asp-items="@(new List<SelectListItem> {
                                    new SelectListItem { Text = "クレジットカード", Value = "クレジットカード" },
                                    new SelectListItem { Text = "PoyPol", Value = "PoyPol" },
                                    new SelectListItem { Text = "コンビニ払い", Value = "コンビニ払い" },
                                    new SelectListItem { Text = "PoyPoy", Value = "PoyPoy" }
                                })">
        </select>
        @* Enumを使用する場合 *@
        @* <select asp-for="PaymentMethod"
                asp-items="Html.GetEnumSelectList<PaymentMethod>()">
        </select> *@
    </div>
    <!-- 趣味（リストボックス） -->
    <div>
        <label asp-for="Hobbies"></label><br />
        <input type="checkbox" name="Hobbies" value="読書" /> 読書
        <input type="checkbox" name="Hobbies" value="音楽" /> 音楽
        <input type="checkbox" name="Hobbies" value="旅行" /> 旅行
    </div>
    <!-- 誕生日（日付入力） -->
    <div>
        <label asp-for="BirthDate"></label>
        <input asp-for="BirthDate" type="date" />
    </div>
    <!-- 利用規約（チェックボックス） -->
    <div>
        <input asp-for="AcceptTerms" />
        <label asp-for="AcceptTerms"></label>
    </div>
    <button type="submit">確認画面へ</button>
</form>