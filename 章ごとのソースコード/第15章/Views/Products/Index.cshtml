@model IPagedList<Product>
@{
    ViewData["Title"] = "商品一覧";
}

<h2>@ViewData["Title"]</h2>

@if (User.IsInRole("Admin"))
{

    <p><a asp-action="Create">新規作成</a></p>
}

<p>全 @Model.TotalItemCount 件中 @Model.FirstItemOnPage - @Model.LastItemOnPage 件を表示（@Model.PageNumber / @Model.PageCount ページ）</p>

<table class="simple-table">
    <thead>
        <tr>
            <th>ID</th>
            <th>商品名</th>
            <th>価格</th>
            <th>カテゴリ</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("N0") 円</td>
                <td>@item.Category?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">詳細</a>

                    @if (User.IsInRole("Admin"))
                    {
                        @: |
                        <a asp-action="Edit" asp-route-id="@item.Id">編集</a>
                        @: |
                        <a asp-action = "Delete" asp-route-id = "@item.Id" > 削除 </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
new PagedListRenderOptions
{
    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
    DisplayLinkToLastPage = PagedListDisplayMode.Always,
    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
    DisplayLinkToNextPage = PagedListDisplayMode.Always,

    LinkToFirstPageFormat = "<< 最初",
    LinkToPreviousPageFormat = "< 前へ",
    LinkToNextPageFormat = "次へ >",
    LinkToLastPageFormat = "最後 >>",
    MaximumPageNumbersToDisplay = 5
})
